# Copy to `.env` and fill in real values. `.env` is git-ignored.

# SQLite by default (zero setup). Swap to Postgres when ready, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/astilo
DATABASE_URL=sqlite:///./astilo.db

# Secret used to sign JWTs — change this in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# CORS: comma-separated list of allowed origins for the frontend (Vite dev server, prod domain, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server bind
HOST=0.0.0.0
PORT=8080
