# Copy this file to `.env` and fill in real values.
# Only VITE_-prefixed vars are exposed to the client (via import.meta.env).
# `.env` is git-ignored — never commit real keys.

# Base URL of the astilo-project-be backend API. All TMDB, lyrics and store
# data is proxied through it — the frontend no longer calls third-party APIs
# or holds their keys directly. Defaults to http://localhost:8080/api.
VITE_BASE_URL=http://localhost:8080/api

# Streaming-server base URLs for the Movies/TV/Anime watch page (see
# src/lib/streams.ts). Each is optional — a provider whose var is unset is
# simply left out of the server switcher. Fill in the ones you want to use,
# e.g. VITE_PROVIDER_VIDSRC=https://vidsrc.to
VITE_PROVIDER_VIDSRC=
VITE_PROVIDER_VIDLINK=
VITE_PROVIDER_VIDSRC_XYZ=
VITE_PROVIDER_VIDSRC_ME=
VITE_PROVIDER_AUTOEMBED=
VITE_PROVIDER_TWOEMBED=
VITE_PROVIDER_TWOEMBED_SKIN=
VITE_PROVIDER_EMBEDSU=
VITE_PROVIDER_VIDCORE=
VITE_PROVIDER_YAPGRID=
VITE_PROVIDER_SUPEREMBED=
VITE_PROVIDER_SMASHY=
