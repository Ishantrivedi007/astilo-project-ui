# Copy this file to `.env` and fill in real values.
# Only VITE_-prefixed vars are exposed to the client (via import.meta.env).
# `.env` is git-ignored — never commit real keys.

# Base URL of the astilo-project-be backend API. All TMDB, lyrics and store
# data is proxied through it — the frontend no longer calls third-party APIs
# or holds their keys directly. Defaults to http://localhost:8080/api.
VITE_BASE_URL=http://localhost:8080/api

# Streaming-server base URLs + display names for the Movies/TV/Anime watch
# page. Both are optional per server (1-24): a server whose base URL is
# unset is left out of the switcher entirely; if its base URL is set but
# its _NAME isn't, it falls back to a generic "Server N" label. Fill in
# the ones you want to use, e.g. VITE_PROVIDER_1=https://example.com
VITE_PROVIDER_1=
VITE_PROVIDER_1_NAME=
VITE_PROVIDER_2=
VITE_PROVIDER_2_NAME=
VITE_PROVIDER_3=
VITE_PROVIDER_3_NAME=
VITE_PROVIDER_4=
VITE_PROVIDER_4_NAME=
VITE_PROVIDER_5=
VITE_PROVIDER_5_NAME=
