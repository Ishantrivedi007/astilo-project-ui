# Copy this file to `.env` and fill in real values.
# Only VITE_-prefixed vars are exposed to the client (via import.meta.env).
# `.env` is git-ignored — never commit real keys.

# Optional base URL for the shared API request helper
VITE_BASE_URL=

# TMDB — powers the Movies page. Get credentials at:
#   https://www.themoviedb.org/settings/api
# Provide EITHER the v4 read access token (preferred) OR the v3 API key.
VITE_TMDB_TOKEN=
VITE_TMDB_API_KEY=

# Genius — OPTIONAL lyrics source for the Music player.
# https://genius.com/api-clients  (use the "Client Access Token")
# Leave blank: the player falls back to lrclib.net / lyrics.ovh (no key needed).
VITE_GENIUS_ACCESS_TOKEN=
