# Copy to `.env` and fill in real values. `.env` is git-ignored.

# SQLite by default (zero setup). Swap to Postgres when ready, e.g.:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/astilo
DATABASE_URL=sqlite:///./astilo.db

# Secret used to sign JWTs — change this in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=24

# CORS: comma-separated list of allowed origins for the frontend (Vite dev server, prod domain, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Server bind
HOST=0.0.0.0
PORT=8080

# TMDB (movies/TV/anime data) — proxied server-side so the key never reaches the browser.
# Prefer the read access token (v4 auth); the v3 API key also works if that's what you have.
TMDB_TOKEN=
TMDB_API_KEY=

# Genius (Lyrics Search tab) — get a Client Access Token at https://genius.com/api-clients.
# Leave blank: lyrics search falls back to lrclib.net / lyrics.ovh (no key needed).
GENIUS_ACCESS_TOKEN=

# Swagger/OpenAPI docs at /api/docs (+ /api/openapi.json). Off by default —
# the routes aren't even mounted unless this is true. Still admin-only and
# JWT-gated on top of that when enabled; see app/controllers/docs_controller.py.
API_DOCS_ENABLED=false

# Alpha Vantage (Markets multi-provider fallback for equities/ETFs/bonds/
# commodities/gold/silver — see app/markets/alphavantage.py). Free,
# instant signup, no payment info: https://www.alphavantage.co/support/#api-key
# Leave blank: that fallback layer is simply inactive, nothing else breaks.
ALPHA_VANTAGE_API_KEY=

# Twelve Data (Markets fallback — real historical gold data only; their
# free tier gates everything else we tried behind a paid plan, see
# app/markets/twelvedata.py). Free, instant signup: https://twelvedata.com/pricing
# Leave blank: that fallback layer is simply inactive, nothing else breaks.
TWELVE_DATA_API_KEY=

# FRED (Markets economic calendar — a real forward-looking US CPI/GDP/
# jobs/FOMC release-date schedule, see app/markets/fred.py). Free,
# instant signup: https://fred.stlouisfed.org/docs/api/api_key.html
# Leave blank: the economic calendar endpoint returns 404 instead of breaking.
FRED_API_KEY=
